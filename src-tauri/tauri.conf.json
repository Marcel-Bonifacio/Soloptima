{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soloptima",
  "identifier": "com.tirtawijata.soloptima",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../TERMS.md": "TERMS.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Utility",
    "shortDescription": "PV, battery and diesel hybrid plant sizing",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKUldSNllQZ0RmbnIvQXZBVTNpYzluMFNWOFZsMnV1d1lkVG51YmdYTklnejJoVTNHQnRTSGJUcDEK",
      "endpoints": [
        "https://github.com/Marcel-Bonifacio/Soloptima/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "Soloptima"
}
